{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignalScout Output",
  "description": "Output schema for the SignalScout bot: trending signals collected from external sources",
  "type": "object",
  "required": ["signals", "timestamp", "sources_used"],
  "properties": {
    "signals": {
      "type": "array",
      "description": "List of trending signals found",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "score", "source"],
        "properties": {
          "id": { "type": "string", "description": "Unique identifier for the signal" },
          "title": { "type": "string", "description": "Title of the signal" },
          "url": { "type": "string", "description": "URL of the original signal" },
          "score": { "type": "number", "minimum": 0, "description": "Raw score from the source" },
          "source": { "type": "string", "description": "Source name (e.g. hackernews, rss)" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "comments": { "type": "integer", "minimum": 0 },
          "published_at": { "type": "string", "description": "ISO 8601 timestamp" }
        }
      }
    },
    "timestamp": { "type": "string", "description": "ISO 8601 timestamp of when signals were collected" },
    "sources_used": { "type": "array", "items": { "type": "string" }, "description": "List of source IDs used" }
  },
  "additionalProperties": false
}
