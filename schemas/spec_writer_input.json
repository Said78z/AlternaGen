{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecWriterInput",
  "description": "Input for SpecWriter bot: the top-ranked idea",
  "type": "object",
  "required": ["idea"],
  "properties": {
    "idea": {
      "type": "object",
      "required": ["id", "title", "url", "source", "composite_score", "rationale"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "id": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "source": {"type": "string"},
        "composite_score": {"type": "number", "minimum": 0, "maximum": 100},
        "raw_score": {"type": "integer", "minimum": 0},
        "raw_comments": {"type": "integer", "minimum": 0},
        "tags": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    },
    "template": {
      "type": "string",
      "description": "Name of the spec template to use",
      "default": "default"
    },
    "extra_context": {
      "type": "string",
      "description": "Optional extra context/instructions for the spec writer",
      "default": ""
    }
  },
  "additionalProperties": false
}
