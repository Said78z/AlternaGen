{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoBootstrapper IO",
  "description": "Input/Output schema for RepoBootstrapper bot",
  "definitions": {
    "input": {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "spec": {"$ref": "#/definitions/spec_ref"},
        "github_org": {"type": "string", "default": ""},
        "repo_visibility": {"type": "string", "enum": ["public", "private"], "default": "private"}
      }
    },
    "output": {
      "type": "object",
      "required": ["repo_name", "repo_url", "branch", "pr_url", "metadata"],
      "properties": {
        "repo_name": {"type": "string"},
        "repo_url": {"type": "string", "format": "uri"},
        "branch": {"type": "string"},
        "pr_url": {"type": "string", "format": "uri"},
        "metadata": {
          "type": "object",
          "properties": {
            "run_at": {"type": "string", "format": "date-time"},
            "spec_id": {"type": "string"}
          }
        }
      }
    },
    "spec_ref": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"}
      }
    }
  }
}
