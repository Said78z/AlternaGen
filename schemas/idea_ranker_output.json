{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdeaRanker Output",
  "description": "Output schema for the IdeaRanker bot: ranked MVP ideas derived from signals",
  "type": "object",
  "required": ["ideas", "timestamp"],
  "properties": {
    "ideas": {
      "type": "array",
      "description": "Ranked list of MVP ideas",
      "items": {
        "type": "object",
        "required": ["rank", "title", "score", "rationale"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "description": "Rank position (1 = best)" },
          "title": { "type": "string", "description": "Concise idea title" },
          "score": { "type": "number", "minimum": 0, "maximum": 100, "description": "Normalized score 0–100" },
          "rationale": { "type": "string", "description": "Why this idea was ranked here" },
          "signals": {
            "type": "array",
            "description": "Source signals that contributed to this idea",
            "items": { "type": "object" }
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "market_size": { "type": "string", "enum": ["small", "medium", "large", "unknown"] },
          "complexity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "timestamp": { "type": "string", "description": "ISO 8601 timestamp" },
    "total_signals_processed": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
