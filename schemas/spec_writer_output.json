{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecWriter Output",
  "description": "Output schema for the SpecWriter bot: full MVP specification",
  "type": "object",
  "required": ["spec", "timestamp"],
  "properties": {
    "spec": {
      "type": "object",
      "required": ["title", "description", "features", "tech_stack", "mvp_scope"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "problem_statement": { "type": "string" },
        "target_audience": { "type": "string" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "priority"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "priority": { "type": "string", "enum": ["must-have", "should-have", "nice-to-have"] }
            }
          }
        },
        "tech_stack": { "type": "array", "items": { "type": "string" } },
        "mvp_scope": { "type": "string", "description": "Clear scope statement for the MVP" },
        "monetization": { "type": "string" },
        "success_metrics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timestamp": { "type": "string" },
    "source_idea": {
      "type": "object",
      "description": "The ranked idea this spec was generated from"
    }
  },
  "additionalProperties": false
}
